.primary-action, .quiet-action { border: 1px solid rgba(255,255,255,.18); padding: 13px 17px; border-radius: 999px; text-transform: uppercase; letter-spacing: .12em; font-size: .65rem; }
.primary-action { background: var(--text); color: #121418; border-color: var(--text); }
.quiet-action { color: var(--text); background: rgba(0,0,0,.18); backdrop-filter: blur(14px); cursor: pointer; }
.primary-action span { color: #676b10; margin-left: 4px; }
.menu-rail { position: absolute; z-index: 10; top: 50%; right: 4.5%; transform: translateY(-50%); width: min(340px, 32vw); display: grid; gap: 10px; }
.menu-item { text-align: left; background: rgba(8,9,12,.34); color: #fff; border: 1px solid rgba(255,255,255,.14); padding: 18px 20px; border-radius: 15px; backdrop-filter: blur(18px); cursor: pointer; transition: .35s ease; }
.menu-item:hover, .menu-item.is-active { transform: translateX(-10px); background: rgba(8,9,12,.62); border-color: rgba(255,255,255,.34); }
.menu-item.is-active { box-shadow: 0 0 0 1px rgba(233,239,92,.25) inset; }
.menu-number { color: var(--accent); font-size: .65rem; letter-spacing: .14em; display: block; margin-bottom: 6px; }
.menu-title { display: block; font-size: 1rem; font-weight: 700; }
.menu-sub { display: block; color: #bec0c5; font-size: .72rem; margin-top: 5px; }
.scroll-cue { position: absolute; z-index: 9; right: 4.5%; bottom: 42px; color: rgba(255,255,255,.6); font-size: .62rem; text-transform: uppercase; letter-spacing: .16em; }

.section-grid, .work-list, .skills-section, .contact-section { padding: 120px clamp(24px, 6vw, 90px); }
.section-grid { display: grid; grid-template-columns: 1.05fr 1.5fr; gap: clamp(36px, 7vw, 110px); align-items: center; border-bottom: 1px solid var(--line); }
.section-label { color: var(--faint); text-transform: uppercase; font-size: .63rem; letter-spacing: .18em; font-weight: 700; }
.story-photo-wrap { max-width: 480px; position: relative; }
.story-photo-wrap::after { content: ""; position: absolute; inset: 12px -12px -12px 12px; border: 1px solid rgba(233,239,92,.35); z-index: -1; }
.story-photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; filter: saturate(.82); }
.story-copy h2, .section-head h2, .skills-section h2 { font-size: clamp(3rem, 6vw, 6.8rem); line-height: .9; letter-spacing: -.05em; margin: 18px 0 30px; }
.quote-stack { display: grid; grid-template-columns: 1.15fr 1fr; gap: 40px; }
blockquote { margin: 0; font-size: clamp(1.35rem, 2.1vw, 2rem); line-height: 1.25; }
.quote-stack > p { color: var(--muted); max-width: 560px; }

.work-list { border-bottom: 1px solid var(--line); }
.section-head { display: flex; justify-content: space-between; gap: 50px; align-items: end; margin-bottom: 60px; }
.section-note { max-width: 390px; color: var(--muted); font-size: .95rem; }
.work-row { display: grid; grid-template-columns: 70px minmax(220px, 38%) 1fr 40px; align-items: center; gap: 30px; padding: 26px 0; border-top: 1px solid var(--line); transition: padding .3s ease; }
.work-row:hover { padding-left: 14px; padding-right: 14px; background: linear-gradient(90deg, rgba(255,255,255,.025), transparent); }
.work-index { font-size: .64rem; letter-spacing: .16em; color: var(--faint); }
.work-thumb { position: relative; overflow: hidden; background: #202228; }
.work-thumb.landscape { aspect-ratio: 16/9; }
.work-thumb.vertical { aspect-ratio: 9/12; width: 180px; justify-self: start; }
.work-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s ease; }
.work-row:hover .work-thumb img { transform: scale(1.035); }
.thumb-play { position: absolute; left: 14px; bottom: 14px; background: rgba(9,10,12,.72); border: 1px solid rgba(255,255,255,.18); padding: 7px 9px; border-radius: 999px; font-size: .57rem; letter-spacing: .16em; }
.work-info h3 { font-size: clamp(1.8rem, 3vw, 3rem); margin: 0 0 10px; letter-spacing: -.04em; }
.work-info p:not(.eyebrow) { max-width: 600px; color: var(--muted); margin-bottom: 0; }
.row-arrow { font-size: 1.4rem; color: #bfc2c7; }

.skills-section { display: grid; grid-template-columns: 1fr 2fr; gap: 60px; border-bottom: 1px solid var(--line); }
.skill-grid { grid-column: 2; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.skill-block { padding-top: 18px; border-top: 1px solid var(--line); }
.skill-number { color: var(--accent); font-size: .62rem; letter-spacing: .16em; }
.skill-block h3 { font-size: 1.05rem; margin-bottom: 8px; }
.skill-block p:last-child { color: var(--muted); font-size: .87rem; }

.contact-section { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; }
.contact-panel h2 { font-size: clamp(3rem, 6vw, 6.7rem); line-height: .9; letter-spacing: -.055em; margin: 18px 0 30px; }
.contact-panel p { color: var(--muted); margin-bottom: 6px; }
.contact-panel a { color: var(--text); text-decoration: underline; text-decoration-color: rgba(233,239,92,.45); text-underline-offset: 4px; }
.contact-side { justify-self: end; text-align: right; font-size: clamp(1.8rem, 4vw, 5.5rem); font-weight: 800; line-height: .83; letter-spacing: -.08em; color: rgba(255,255,255,.12); }
.contact-side span { color: rgba(233,239,92,.5); font-size: .28em; letter-spacing: .12em; }
.footer { display: flex; gap: 20px; justify-content: space-between; padding: 26px 24px 34px; color: #70747d; font-size: .65rem; text-transform: uppercase; letter-spacing: .13em; }
.footer a { color: #a1a5aa; }

/* Project pages */
.project-topbar { position: sticky; top: 0; background: rgba(10,11,14,.8); backdrop-filter: blur(16px); z-index: 20; }
.back-link { color: #c8c9cd; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }
.project-hero, .commercial-hero { min-height: 100vh; padding: 118px 24px 70px; display: grid; align-items: center; gap: 70px; }
.project-hero { grid-template-columns: 1.55fr .85fr; }
.project-hero-media { background: #0e1014; border: 1px solid var(--line); }
.project-hero-media video { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
.project-hero-copy h1, .commercial-copy h1 { font-size: clamp(4rem, 8vw, 8rem); line-height: .83; letter-spacing: -.065em; margin: 12px 0 28px; }
.lead { font-size: clamp(1rem, 1.5vw, 1.22rem); color: #d9d9d5; max-width: 600px; }
.project-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 26px; }
.project-tags span { border: 1px solid var(--line); padding: 7px 10px; border-radius: 999px; color: #c3c5ca; text-transform: uppercase; font-size: .6rem; letter-spacing: .12em; }
.project-story { padding: 120px 24px; display: grid; grid-template-columns: .5fr 1.5fr; gap: 40px; border-top: 1px solid var(--line); }
.project-side-label { font-size: .62rem; letter-spacing: .18em; color: var(--faint); text-transform: uppercase; }
.detail-block h2 { font-size: clamp(2.7rem, 5vw, 5.6rem); line-height: .9; letter-spacing: -.05em; margin: 10px 0 40px; }
.detail-block h3 { font-size: 1rem; margin-bottom: 10px; }
.detail-block p { color: var(--muted); max-width: 620px; }
.detail-columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
.reflection-panel { margin: 0 24px 120px; padding: 70px; border: 1px solid var(--line); display: grid; grid-template-columns: .45fr 1.55fr; gap: 40px; background: #0f1218; }
.reflection-mark { color: var(--accent); font-size: .62rem; letter-spacing: .18em; text-transform: uppercase; }
.reflection-copy h2 { font-size: clamp(2.8rem, 5vw, 6rem); line-height: .88; letter-spacing: -.055em; margin-bottom: 28px; }
.reflection-copy p { color: #d0d1d4; max-width: 850px; font-size: 1.05rem; }
.technical-band { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 24px 120px; }
.technical-band > div { padding: 28px; border-right: 1px solid var(--line); }
.technical-band > div:last-child { border-right: 0; }
.technical-band span { display: block; color: var(--faint); font-size: .6rem; letter-spacing: .17em; text-transform: uppercase; margin-bottom: 7px; }
.technical-band strong { font-size: 1rem; }
.project-next { padding: 0 24px 120px; }
.next-project { display: flex; justify-content: space-between; gap: 20px; padding: 32px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.next-project span { color: var(--faint); text-transform: uppercase; font-size: .62rem; letter-spacing: .16em; }
.next-project strong { font-size: clamp(1.8rem, 3vw, 3.4rem); letter-spacing: -.045em; }

.commercial-hero { grid-template-columns: .92fr 1.08fr; }
.commercial-visual { width: min(480px, 100%); justify-self: center; background: #0f1215; border: 1px solid var(--line); padding: 8px; }
.commercial-visual video { width: 100%; aspect-ratio: 9/16; object-fit: cover; background: #0b0d10; }
.commercial-copy { padding-right: 4vw; }
.production-board { margin: 0 24px; padding: 100px 6vw; background: #d8d7cf; color: #111; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; }
.production-board .eyebrow { color: #676865; }
.board-title h2 { font-size: clamp(3.4rem, 6vw, 7rem); line-height: .85; letter-spacing: -.06em; margin-bottom: 0; }
.board-list { margin-top: 32px; border-top: 1px solid rgba(0,0,0,.18); }
.board-list div { display: grid; grid-template-columns: 44px 1fr; padding: 14px 0; border-bottom: 1px solid rgba(0,0,0,.18); }
.board-list span { color: #74756f; font-size: .62rem; letter-spacing: .14em; }
.board-copy > p { max-width: 620px; font-size: 1.05rem; }
.take-layout { padding: 120px 24px; display: grid; grid-template-columns: 1.1fr .9fr; gap: 70px; align-items: center; }
.take-visual img { width: 100%; max-height: 760px; object-fit: cover; object-position: center 20%; }
.take-copy { max-width: 600px; }
.take-copy h2 { font-size: clamp(3rem, 5vw, 5.8rem); line-height: .86; letter-spacing: -.055em; margin: 15px 0 25px; }
.take-copy p { color: var(--muted); max-width: 560px; }
.reflection-panel-light { background: #e8e5dc; color: #111; border: 0; }
.reflection-panel-light .reflection-mark { color: #71732b; }
.reflection-panel-light .reflection-copy p { color: #333; }
.technical-band-light { color: #111; background: #e8e5dc; border-color: rgba(0,0,0,.16); }
.technical-band-light > div { border-color: rgba(0,0,0,.16); }
.technical-band-light span { color: #71716a; }

@media (max-width: 980px) {
  .topbar-actions { display: none; }
  .menu-rail { right: 24px; width: min(310px, 42vw); }
  .stage-copy { width: min(700px, 62vw); }
  .section-grid, .skills-section, .contact-section, .project-hero, .commercial-hero, .project-story, .production-board, .take-layout { grid-template-columns: 1fr; }
  .skill-grid { grid-column: 1; }
  .quote-stack, .detail-columns { grid-template-columns: 1fr; }
  .contact-side { justify-self: start; text-align: left; }
  .work-row { grid-template-columns: 50px 42% 1fr; }
  .row-arrow { display: none; }
  .commercial-visual { justify-self: start; width: min(460px, 90%); }
}

@media (max-width: 680px) {
  .topbar { padding: 16px 18px; }
  .stage-copy { top: 17%; left: 18px; width: calc(100% - 36px); }
  .stage-copy h1 { font-size: clamp(3.5rem, 18vw, 6rem); }
  .stage-summary { max-width: 500px; }
  .stage-meta { flex-wrap: wrap; gap: 9px 14px; }
  .stage-cta-row { left: 18px; bottom: 128px; }
  .menu-rail { right: 18px; left: 18px; bottom: 18px; top: auto; transform: none; width: auto; grid-template-columns: repeat(3, 1fr); }
  .menu-item { padding: 12px 10px; border-radius: 12px; }
  .menu-title { font-size: .72rem; line-height: 1.15; }
  .menu-sub { display: none; }
  .menu-number { margin-bottom: 4px; }
  .scroll-cue { display: none; }
  .section-grid, .work-list, .skills-section, .contact-section { padding: 76px 18px; }
  .story-photo-wrap { max-width: 420px; }
  .section-head { display: block; }
  .section-note { margin-top: 20px; }
  .work-row { grid-template-columns: 30px 1fr; gap: 16px; }
  .work-thumb { grid-column: 2; }
  .work-info { grid-column: 2; }
  .work-row-vertical .work-thumb.vertical { width: 160px; }
  .skills-section .skill-grid { grid-template-columns: 1fr; }
  .contact-panel h2 { font-size: clamp(3rem, 15vw, 5rem); }
  .project-hero, .commercial-hero { padding: 94px 18px 55px; gap: 42px; }
  .project-story, .take-layout { padding: 76px 18px; }
  .reflection-panel { margin: 0 18px 76px; padding: 34px 24px; grid-template-columns: 1fr; }
  .technical-band { grid-template-columns: 1fr 1fr; margin: 0 18px 76px; }
  .technical-band > div { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .technical-band > div:nth-child(2n) { border-right: 0; }
  .technical-band > div:nth-last-child(-n+2) { border-bottom: 0; }
  .production-board { margin: 0 18px; padding: 62px 24px; }
  .commercial-visual { width: 100%; }
  .project-next { padding: 0 18px 76px; }
  .next-project { display: block; }
  .next-project strong { display: block; margin-top: 12px; }
  .footer { padding-inline: 18px; flex-wrap: wrap; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { transition-duration: .001ms !important; animation-duration: .001ms !important; }
}
